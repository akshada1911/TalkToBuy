# TalkToBuy MVP environment. Copy to mvp/.env (git-ignored) and fill in.
# Never put real secrets in this file.

# --- Google Cloud ---
# The dedicated TalkToBuy GCP project. REQUIRED for any Gemini/Vertex/Firestore call.
# The services refuse to start Google adapters if this is a placeholder. They never fall back
# to the gcloud default project.
GCP_PROJECT=REPLACE_WITH_TALKTOBUY_PROJECT_ID
# Region for Cloud Run and the Live model (gemini-3.8-live with Live Avatar).
GCP_LOCATION=us-central1
# Preset Live Avatar name (e.g. Kai, Leo, Vera). Custom avatars need allowlisting.
AVATAR_NAME=Kai
# Prebuilt HD voice paired with the avatar (e.g. Charon, Kore, Puck).
VOICE_NAME=Charon
# Firestore database ID for sessions and usage logs ("(default)" for the default DB).
FIRESTORE_DATABASE=(default)
# Cloud Storage bucket holding product images.
IMAGE_BUCKET=REPLACE_WITH_IMAGE_BUCKET

# --- Service URLs ---
# Base URL of the demo store, as seen by the session server.
STORE_BASE_URL=http://localhost:3000
# Public base URL of the session server (used in the UCP-Agent profile header).
SESSION_SERVER_URL=http://localhost:8080
# Origin of the demo shop app; the only origin allowed to call /v1/demo-ticket.
SHOP_ORIGIN=http://localhost:5173

# --- Modes ---
# live = hybrid embedding search; seeded = fixed results for the demo script (FR-044).
SEARCH_MODE=live
# ucp = UCP 2026-08-25 endpoints; rest = plain REST fallback with the same tools.
COMMERCE_ADAPTER=ucp
# audio_only (default, cheapest) = voice + illustrated shopkeeper; avatar = Live Avatar video. The widget switch / ?avatar=1 overrides per session.
MEDIA_MODE_DEFAULT=audio_only

# --- Demo operations ---
# Server-side key for /demo/reset and server-to-server /v1/tickets. NEVER bundled into a frontend.
DEMO_ADMIN_KEY=change-me
# Secret used to sign session tickets (HMAC). Server-side only.
TICKET_SIGNING_SECRET=change-me-too
# Cost guards for the keyless /v1/demo-ticket (S1).
MAX_CONCURRENT_SESSIONS=3
DAILY_SESSION_QUOTA=100
DEMO_TICKETS_ENABLED=true

# --- Open Food Facts import ---
# Contact email required by Open Food Facts in the User-Agent of import scripts.
OFF_CONTACT_EMAIL=REPLACE_WITH_TEAM_CONTACT_EMAIL

# memory = local dev; firestore = Cloud Run (needs the Firestore API).
STATE_BACKEND=memory
# Fast text model for caption translation and safety classification (R8, R10).
FLASH_MODEL=gemini-2.5-flash
# Cheaper model for display-only English captions (assistant lines only, when English is on).
TRANSLATE_MODEL=gemini-2.5-flash-lite
# Cost controls: end idle sessions; summarise old context early; products per search.
IDLE_TIMEOUT_S=60
IDLE_WARN_S=50
COMPRESS_TRIGGER_TOKENS=16000
COMPRESS_TARGET_TOKENS=8000
SEARCH_LIMIT=5
