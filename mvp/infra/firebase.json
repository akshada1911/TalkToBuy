{
  "hosting": {
    "public": "../apps/shop/dist",
    "ignore": ["firebase.json", "**/.*"],
    "rewrites": [
      { "source": "/payment/**", "run": { "serviceId": "talktobuy-demo-store", "region": "us-central1" } },
      { "source": "/demo/**", "run": { "serviceId": "talktobuy-demo-store", "region": "us-central1" } },
      { "source": "/static/**", "run": { "serviceId": "talktobuy-demo-store", "region": "us-central1" } },
      { "source": "**", "destination": "/index.html" }
    ],
    "headers": [
      { "source": "**", "headers": [{ "key": "Permissions-Policy", "value": "camera=(self), microphone=(self), publickey-credentials-get=(self)" }] }
    ]
  }
}
